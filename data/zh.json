[["它", "这是我的书。", "zhè shì wǒ de shū."], ["到 / 连词", "我想去这里。", "wǒ xiǎng qù zhè lǐ."], ["和", "我和你。", "wǒ hé nǐ."], ["我", "我是学生。", "wǒ shì xué shēng."], ["在...上", "书在桌子上。", "shū zài zhuō zi shàng."], ["一个", "我有一个苹果。", "wǒ yǒu yí gè píng guǒ."], ["不", "我不知道。", "wǒ bù zhī dào."], ["像 / 谁", "他像他父亲。", "tā xiàng tā fù qīn."], ["为了", "这是给你的。", "zhè shì gěi nǐ de."], ["和...一起", "我和朋友去。", "wǒ hé péng you qù."], ["有", "我有一只猫。", "wǒ yǒu yì zhī māo."], ["的 / 由", "这是他做的。", "zhè shì tā zuò de."], ["如果", "如果下雨，我就不去。", "rú guǒ xià yǔ, wǒ jiù bú qù."], ["你", "你好吗？", "nǐ hǎo ma?"], ["所以", "我很累，所以休息。", "wǒ hěn lèi, suǒ yǐ xiū xi."], ["到", "我去学校。", "wǒ qù xué xiào."], ["它", "看那个。", "kàn nà gè."], ["他们", "他们是我的朋友。", "tā men shì wǒ de péng you."], ["一个", "这是一个家。", "zhè shì yí gè jiā."], ["我们", "我们去吧。", "wǒ men qù ba."], ["但是", "我想去，但是很累。", "wǒ xiǎng qù, dàn shì hěn lèi."], ["人们", "这里不让抽烟。", "zhè lǐ bú ràng chōu yān."], ["是", "我是中国人。", "wǒ shì zhōng guó rén."], ["什么时候", "你什么时候来？", "nǐ shén me shí hou lái?"], ["现在", "我现在很忙。", "wǒ xiàn zài hěn máng."], ["什么", "这是什么？", "zhè shì shén me?"], ["从", "我从中国来。", "wǒ cóng zhōng guó lái."], ["这里", "我的家在这里。", "wǒ de jiā zài zhè lǐ."], ["只是", "我只是看看。", "wǒ zhǐ shì kàn kàn."], ["或者", "茶还是咖啡？", "chá hái shì kā fēi?"], ["他", "他是我的老师。", "tā shì wǒ de lǎo shī."], ["那时", "我那时很年轻。", "wǒ nà shí hěn nián qīng."], ["怎么", "这个怎么做？", "zhè gè zěn me zuò?"], ["来", "他来我家。", "tā lái wǒ jiā."], ["全部", "所有人都在。", "suǒ yǒu rén dōu zài."], ["想要", "我想喝水。", "wǒ xiǎng hē shuǐ."], ["自己", "他洗脸。", "tā xǐ liǎn."], ["那里", "书在那里。", "shū zài nà lǐ."], ["得到", "我得到了一份礼物。", "wǒ dé dào le yí fèn lǐ wù."], ["好", "天气很好。", "tiān qì hěn hǎo."], ["存在", "桌上有书。", "zhuō shàng yǒu shū."], ["外", "他出去了。", "tā chū qù le."], ["我的", "这是我的车。", "zhè shì wǒ de chē."], ["毕竟", "你知道的。", "nǐ zhī dào de."], ["一点", "我懂一点中文。", "wǒ dǒng yì diǎn zhōng wén."], ["很多", "我有很多书。", "wǒ yǒu hěn duō shū."], ["上", "请站起来。", "qǐng zhàn qǐ lái."], ["里", "请进来。", "qǐng jìn lái."], ["做", "你在做什么？", "nǐ zài zuò shén me?"], ["成为", "我想成为医生。", "wǒ xiǎng chéng wéi yī shēng."]]